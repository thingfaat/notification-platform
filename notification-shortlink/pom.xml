<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tam.notification</groupId>
        <artifactId>notification-platform</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>notification-shortlink</artifactId>
    <packaging>jar</packaging>

    <name>notification-shortlink</name>
    <description>短链子系统：短码生成、短链跳转、Redis缓存、防缓存穿透、点击事件异步统计、短链有效期、租户隔离</description>

    <dependencies>
        <!-- Internal -->
        <dependency>
            <groupId>com.tam.notification</groupId>
            <artifactId>notification-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tam.notification</groupId>
            <artifactId>notification-infrastructure</artifactId>
        </dependency>

        <!-- Spring Boot Web (for redirect endpoint) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Monitoring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JUnit 5 + Mockito -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
